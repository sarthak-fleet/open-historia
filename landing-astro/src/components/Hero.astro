---
// Hero — LCP surface.
//
// The H1 ("OPEN HISTORIA") is the LCP element. Rendered in Playfair
// Display 900 with wide letter-spacing to echo the in-game OG image
// (app/opengraph-image.tsx → `letterSpacing: 8`).
//
// Single CTA points at /play. The Worker currently owns / and renders
// the game there — see README cutover notes. The /play move has to
// happen before Pages can take / for this landing.
---

<section class="oh-hero">
  <div class="oh-hero-frame" aria-hidden="true"></div>

  <div class="oh-eyebrow">
    <span class="oh-eyebrow-dot" aria-hidden="true"></span>
    AI grand strategy &mdash; in your browser
  </div>

  <h1 class="oh-hero-h1">
    Open <em>Historia</em>
  </h1>

  <div class="oh-hero-divider" aria-hidden="true"></div>

  <p class="oh-hero-tagline">
    Rewrite history. Command nations in plain English.
  </p>

  <p class="oh-hero-sub">
    Type &ldquo;invade Bohemia&rdquo; or &ldquo;send envoy to the Ottoman court.&rdquo;
    An AI Game Master moves armies, shifts treaties, and remembers your campaign
    across 20+ scenarios from 793 AD to 2040.
  </p>

  <div class="oh-hero-actions">
    <a href="/play" class="oh-btn-primary">
      Pick a scenario and start <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <p class="oh-hero-fine">
    Free &middot; open source &middot; bring your own AI key or use the free tier &middot;
    <a href="https://github.com/sarthakagrawal927/open-historia" rel="noopener">GitHub</a>
  </p>
</section>
