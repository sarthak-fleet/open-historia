---
// Self-hosted variable fonts. Astro inlines the @font-face into the
// page's CSS via Lightning CSS (build.inlineStylesheets: 'always'),
// so we drop the external fonts.googleapis.com round-trip from the
// LCP path. Families register as 'Playfair Display Variable' and
// 'Geist Variable' — mapped onto the existing --font-* CSS vars below
// so landing.css needs no changes. Geist Mono stays fallback-only
// (matches the original Next.js layout — never preloaded here).
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/geist';
import '@/styles/landing.css';
import {
  publicRouteForPath,
  routeMetadata,
  structuredDataForRoute,
} from '../../../public-route-contract.mjs';

const home = publicRouteForPath('/');
const metadata = home ? routeMetadata(home) : null;
const structuredData = home ? structuredDataForRoute(home) : null;
if (!home || !metadata || !structuredData) {
  throw new Error('Open Historia home route metadata is unavailable.');
}
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0F19" />

    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <meta name="robots" content={metadata.robots} />
    <meta name="application-name" content="Open Historia" />

    <link rel="canonical" href={metadata.canonical} />
    <link rel="alternate" type="text/markdown" href={metadata.markdown} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={metadata.canonical} />
    <meta property="og:site_name" content="Open Historia" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:image" content={metadata.image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={metadata.image} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}
    />

    <meta
      name="keywords"
      content="grand strategy, AI game, strategy game, historical simulation, open source, EU4, Paradox, geopolitics, war game, diplomacy"
    />

    {/* Wire the same CSS vars the Next.js layout sets up via next/font,
       so landing.css can reference them without changes. Fontsource
       Variable registers families as '<Name> Variable'; plain names
       stay in the fallback chain. Geist Mono is fallback-only —
       matches the original Next.js layout (never preloaded here). */}
    <style is:inline>
      :root {
        --font-playfair: 'Playfair Display Variable', 'Playfair Display', Georgia, 'Times New Roman', serif;
        --font-geist-sans: 'Geist Variable', 'Geist', system-ui, -apple-system, sans-serif;
        --font-geist-mono: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      }
      html.dark { color-scheme: dark; }
      body { margin: 0; }
    </style>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
