---
import '@/styles/landing.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const SITE_URL = 'https://open-historia.sarthakagrawal927.workers.dev';
// OG image lives on the Next.js Worker at /opengraph-image (Next file
// convention → dynamic JSX → PNG). Post-cutover Pages takes only `/`
// and the Worker keeps everything else, so this URL still resolves.
// See README → cutover notes.
const OG_IMAGE = `${SITE_URL}/opengraph-image`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0F19" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Open Historia" />

    <link rel="canonical" href={SITE_URL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:site_name" content="Open Historia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <meta
      name="keywords"
      content="grand strategy, AI game, strategy game, historical simulation, open source, EU4, Paradox, geopolitics, war game, diplomacy"
    />

    {/* ── Fonts ────────────────────────────────────────────────────
       Playfair Display 700 carries the hero H1 (LCP element) and the
       brand wordmark. Geist Sans is the body face. Both load via the
       async preload pattern: preload, then swap media print → all on
       load so the stylesheet never blocks first paint. The plain
       <link rel="stylesheet"> inside <noscript> is the no-JS fallback.

       Geist Mono is referenced by .oh-eyebrow / .oh-mono accents but
       intentionally NOT preloaded — it isn't on the LCP path. The
       weight + subset cost wasn't worth the marginal terminal flavor
       on first paint; mono falls through to the CSS-stack fallback
       until Google Fonts catches up post-paint. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Geist:wght@300;400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Geist:wght@300;400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Geist:wght@300;400;500;600;700&display=swap"
      />
    </noscript>

    {/* Wire the same CSS vars the Next.js layout sets up via next/font,
       so landing.css can reference them without changes. */}
    <style is:inline>
      :root {
        --font-playfair: 'Playfair Display', Georgia, 'Times New Roman', serif;
        --font-geist-sans: 'Geist', system-ui, -apple-system, sans-serif;
        --font-geist-mono: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      }
      html.dark { color-scheme: dark; }
      body { margin: 0; }
    </style>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
