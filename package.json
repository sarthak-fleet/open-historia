{
  "name": "open-historia",
  "version": "0.1.0",
  "packageManager": "pnpm@11.0.8",
  "private": true,
  "scripts": {
    "dev": "cd server && npm install --silent && node index.mjs & next dev",
    "build": "next build --webpack",
    "start": "next start",
    "cf:build": "next build --webpack && node scripts/inline-critical-css.mjs && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare populateCache local && pnpm --filter ./landing-astro build && node scripts/overlay-astro-landing.mjs",
    "validate:env:deploy": "node scripts/validate-env.mjs deploy",
    "deploy": "pnpm validate:env:deploy && pnpm cf:build && wrangler deploy",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.17.3",
    "@saas-maker/feedback": "^0.2.1",
    "better-auth": "^1.6.9",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.4",
    "openai": "^6.34.0",
    "posthog-js": "^1.372.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-map-gl": "^8.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.4",
    "@playwright/test": "^1.59.1",
    "@saas-maker/eslint-config": "^1.0.1",
    "@saas-maker/prettier-config": "^1.0.0",
    "@saas-maker/tsconfig": "^1.0.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "beasties": "^0.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "tailwindcss": "^4.2.4",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.5",
    "wrangler": "^4.85.0"
  },
  "prettier": "@saas-maker/prettier-config"
}
